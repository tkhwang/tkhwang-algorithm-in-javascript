---
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import Link from '@components/link.astro'
import Seo from '@components/seo.astro'
import Spacer from '@components/spacer.astro'
import { FRONTMATTER_TAGS } from '@constants'
import Layout from '@layouts/layout.astro'
import { defaultDateFormat, getPostsByTag, sortDesc, getTags } from '@utils'
import { getCollection } from 'astro:content'
import TagLinks from '@components/tag-links.astro'

/**
 * 1. Generate static pages for all tags.
 * 2. Each tag page will have a list of entries associated with that tag.
 */
export async function getStaticPaths() {
	const entries = sortDesc(await getCollection('blog'))
	const tagsCloud = getTags(entries)
	const totalPosts = entries.length

	const result = []

	for (const tag of FRONTMATTER_TAGS) {
		const postsWithTag = getPostsByTag(entries, tag)

		if (!postsWithTag.length) continue

		result.push({
			params: {
				tag,
			},
			props: {
				tagName: tag,
				postsWithTag,
				tagsCloud,
				totalPosts,
			},
		})
	}

	return result
}

const { tagName, postsWithTag, tagsCloud, totalPosts } = Astro.props
const orderedTags = [...tagsCloud].sort((a, b) => a.tag.localeCompare(b.tag))
const currentTagCount = postsWithTag.length
---

<Layout>
	<Seo slot="seo" title={`Tag: ${tagName}`} />
	<SkipNavContent>
		<div class="border-b border-border pb-4">
			<div class="flex flex-wrap items-center gap-3">
				<span class="font-medium text-lg md:text-xl lg:text-2xl text-highlight">Tag:</span>
				<span
					class="inline-flex items-center rounded-full bg-blue-100 px-4 py-1 text-base font-semibold text-blue-800 dark:bg-blue-500/30 dark:text-blue-100"
				>
					{tagName}
				</span>
				<span class="text-subtle text-base font-normal">({currentTagCount})</span>
			</div>
		</div>
		<Spacer axis="vertical" size={12} />
		<div class="flex flex-wrap gap-3">
			<Link
				class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold text-blue-800 transition-colors no-underline! hover:no-underline! hover:bg-blue-200! hover:text-blue-900! dark:bg-blue-500/20 dark:text-blue-100 dark:hover:bg-blue-500/40! dark:hover:text-blue-50!"
				href="/tags/"
			>
				<span>all</span>
				<span class="text-[11px] font-normal text-blue-900/70 dark:text-blue-100/70">{totalPosts}</span>
			</Link>
			{
				orderedTags.map(({ tag, slug, count }) => {
					const isActive = tag === tagName
					return (
						<Link
							class={`inline-flex items-center gap-1 rounded-full px-3 py-1 text-sm font-semibold transition-colors no-underline! hover:no-underline! ${
								isActive
									? 'bg-blue-600 text-white hover:bg-blue-600! dark:bg-blue-400 dark:text-slate-900 dark:hover:bg-blue-400!'
									: 'bg-blue-100 text-blue-800 hover:bg-blue-200! hover:text-blue-900! dark:bg-blue-500/20 dark:text-blue-100 dark:hover:bg-blue-500/40! dark:hover:text-blue-50!'
							}`}
							href={`/tags/${slug}/`}
							aria-current={isActive ? 'page' : undefined}
						>
							<span>{tag}</span>
							<span
								class={`text-[11px] font-normal ${isActive ? 'text-white/80 dark:text-slate-900/80' : 'text-blue-900/70 dark:text-blue-100/70'}`}
							>
								{count}
							</span>
						</Link>
					)
				})
			}
		</div>
		<Spacer axis="vertical" size={16} />
		<div class="flex gap-10 flex-col">
			{
				postsWithTag.map(({ data: post }) => (
					<div>
						<Link variant="highlight" href={`/blog/${post.slug}/`}>
							{post.title}
						</Link>
						<Spacer axis="vertical" size={2} />
						{post.description ? (
							<>
								<div class="text-subtle text-description-muted text-md md:text-lg">{post.description}</div>
								<Spacer axis="vertical" size={2} />
							</>
						) : null}
						<div class="flex flex-wrap items-center gap-3 text-faded text-sm">
							<span>{defaultDateFormat(post.date)}</span>
							<TagLinks tags={post.tags} />
						</div>
					</div>
				))
			}
		</div>
	</SkipNavContent>
</Layout>
