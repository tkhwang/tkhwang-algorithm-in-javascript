---
import { FRONTMATTER_TAGS, type FrontmatterTag } from '@constants'
import Link from './link.astro'

interface Props {
	tags: FrontmatterTag[]
	class?: string
	badgeClass?: string
}

const { tags, class: className = '', badgeClass = '' } = Astro.props
---

{
	tags.length ? (
		<div class={`flex flex-wrap gap-2 ${className}`.trim()}>
			{tags.map((tag) => (
				<Link
					class={`inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-800 transition-colors hover:bg-blue-200! no-underline! hover:no-underline! focus-visible:no-underline! hover:text-blue-900! ${badgeClass}`.trim()}
					data-pagefind-filter="tag"
					href={`/tags/${tag}/`}
				>
					{tag}
				</Link>
			))}
		</div>
	) : null
}
